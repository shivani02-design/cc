Program:#include<stdio.h>
voidrotate(intarr[],intn,intk){k=k%n;
inttemp[k];
for(inti=0;i<k;i++){temp[i]=arr[n-k+i];
}
for(inti=n-1;i>=k;i--){
arr[i]=arr[i-k];
}
for(inti=0;i<k;i++){arr[i]=temp[i];
}
}
intmain(){intn,k;
printf("Enterthesizeofthearray:");scanf("%d"
,&n);
intarr[n];
