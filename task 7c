//Miller-Rabinprimalitytest
intisPrimeMillerRabin(longlongn,intk){
if(n<=1||n==4)return0;
if(n<=3)return1;
//Finddsuchthatn-1=2^s*d
longlongd=n-1;
while(d%2==0)
d/=2;
//Performkiterations
for(inti=0;i<k;i++){
if(!millerTest(d,n))
return0;
}
return1;
}
