#include<stdio.h>
intgcd(inta,intb){
if(b==0){
returna;
}else{
returngcd(b,a%b);
}
}
intmain(){
intn,k;
scanf("%d%d"
,&n,&k);
intarr[n];
for(inti=0;i<n;i++){
scanf("%d"
,&arr[i]);
}
intmaxLength=0;
intlength=0;
for(inti=0;i<n;i++){
intcurrentGcd=arr[i];
if(currentGcd>=k){
length=1;
}else{
continue;
}
for(intj=i+1;j<n;j++){
currentGcd=gcd(currentGcd,arr[j]);
if(currentGcd>=k){
length++;
}else{
break;
}
}
if(length>maxLength){
maxLength=length;
}
}
printf("%d\n"
,maxLength);
return0;
}
