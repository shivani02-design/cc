//Millertestforasinglebase'a'
intmillerTest(longlongd,longlongn){
longlonga=2+rand()%(n-4);
longlongx=power(a,d,n);
if(x==1||x==n-1)
return1;
//Keepsquaringxuntildbecomesn-1
