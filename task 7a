#include<stdio.h>
#include<stdbool.h>
voidsieveOfEratosthenes(intn){
boolprime[n+1]; //Booleanarraytotrackprimes
for(inti=0;i<=n;i++)
prime[i]=true; //Assumeallnumbersareprimeinitially
prime[0]=prime[1]=false;//0and1arenotprime
for(intp=2;p*p<=n;p++){
if(prime[p]==true){
//Markallmultiplesofpasnotprime
for(inti=p*p;i<=n;i+=p)
prime[i]=false;
}
}
//Printprimenumbers
printf("Primenumbersupto%dare:\n"
,n);
for(inti=2;i<=n;i++){
if(prime[i])
printf("%d"
,i);
}
printf("\n");
}
intmain(){
intn;
printf("Enterthelimit:");
scanf("%d"
,&n);
sieveOfEratosthenes(n);
return0;
}
